{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, e.subject, e.status, e.sender_user_id, e.created_at, e.sent_at, e.completed_at, e.voided_at, e.expires_at, (SELECT count(*) FROM recipients AS r WHERE r.account_id = e.account_id AND r.envelope_id = e.id) AS \"recipients!\" FROM envelopes AS e WHERE e.account_id = $1 AND e.deleted_at IS NULL AND EXISTS (SELECT 1 FROM envelope_states AS s WHERE s.account_id = e.account_id AND s.envelope_id = e.id) AND e.created_at >= $2 AND e.created_at < $3 AND ($4::uuid IS NULL OR e.sender_user_id = $4) ORDER BY e.created_at DESC, e.id DESC LIMIT $5",
