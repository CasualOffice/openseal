  "db_name": "PostgreSQL",
  "query": "SELECT s.id, s.run_id, s.document_id, s.kind, s.page, s.rect, s.label, s.span_start, s.span_end, s.normalized, s.template_id, s.pages_matched, s.pages_total, s.score, s.model_id, s.weights_sha256, s.state, s.decided_by, s.decided_at FROM suggestions s JOIN analysis_runs r ON r.account_id = s.account_id AND r.id = s.run_id WHERE s.account_id = $1 AND r.envelope_id = $2 AND ($3::text IS NULL OR s.kind = $3) AND ($4::text IS NULL OR s.state = $4) AND ($5::uuid IS NULL OR s.id > $5) AND ($6::uuid IS NULL OR s.id = $6) ORDER BY s.id LIMIT $7",
