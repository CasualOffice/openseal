{
  "db_name": "PostgreSQL",
  "query": "SELECT id, sender_user_id, status, subject, message, routing_mode, expires_at, reminder_policy, signing_options, seal_profile, completion_delivery, template_ids, version, chain_head, created_at, sent_at, completed_at, voided_at, updated_at, deleted_at, lower(subject) AS \"subject_key!\" FROM envelopes AS e WHERE account_id = $1 AND deleted_at IS NULL AND EXISTS (SELECT 1 FROM envelope_states AS s WHERE s.account_id = e.account_id AND s.envelope_id = e.id) AND (cardinality($2::text[]) = 0 OR status = ANY($2)) AND ($3::uuid IS NULL OR sender_user_id = $3) AND ($4::text IS NULL OR subject ILIKE $4 ESCAPE '\\' OR EXISTS (SELECT 1 FROM recipients AS r WHERE r.account_id = e.account_id AND r.envelope_id = e.id AND (r.name ILIKE $4 ESCAPE '\\' OR r.email ILIKE $4 ESCAPE '\\'))) AND ($5::timestamptz IS NULL OR updated_at >= $5) AND ($6::timestamptz IS NULL OR updated_at < $6) AND (NOT $7::bool OR (created_at, id) < ($8, $9::uuid)) ORDER BY created_at DESC, id DESC LIMIT $10",
