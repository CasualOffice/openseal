{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id AS envelope_id, e.subject, e.status AS envelope_status, r.name, r.email, r.type AS rtype, r.status, r.routing_order FROM envelopes AS e JOIN recipients AS r ON r.account_id = e.account_id AND r.envelope_id = e.id WHERE e.account_id = $1 AND e.deleted_at IS NULL AND EXISTS (SELECT 1 FROM envelope_states AS s WHERE s.account_id = e.account_id AND s.envelope_id = e.id) AND e.created_at >= $2 AND e.created_at < $3 AND ($4::uuid IS NULL OR e.sender_user_id = $4) ORDER BY e.created_at DESC, e.id DESC, r.routing_order, r.id LIMIT $5",
