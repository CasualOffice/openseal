{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.owner_user_id, t.name, t.email_subject, t.email_message, t.settings, t.matching_rules, t.version, r.share_right, EXISTS (SELECT 1 FROM template_favourites f WHERE f.account_id = $1 AND f.template_id = t.id AND f.user_id = $2) AS \"favourite!\", EXISTS (SELECT 1 FROM template_shares s WHERE s.account_id = $1 AND s.template_id = t.id) AS \"shared!\" FROM templates t CROSS JOIN LATERAL (SELECT openseal_template_share_right($1, t.id, $2) AS share_right) r WHERE t.account_id = $1 AND t.deleted_at IS NULL AND ($3 OR t.owner_user_id = $2 OR r.share_right IS NOT NULL) AND CASE $4::text WHEN 'owned' THEN t.owner_user_id = $2 WHEN 'shared' THEN t.owner_user_id <> $2 AND r.share_right IS NOT NULL WHEN 'favourites' THEN EXISTS (SELECT 1 FROM template_favourites f WHERE f.account_id = $1 AND f.template_id = t.id AND f.user_id = $2) ELSE true END ORDER BY t.name, t.id",
