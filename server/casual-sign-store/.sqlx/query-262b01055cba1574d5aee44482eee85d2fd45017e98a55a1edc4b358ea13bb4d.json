{
  "db_name": "PostgreSQL",
  "query": "SELECT b.id, b.sender_user_id, b.template_id, b.name, b.status, b.row_count, b.created_at, b.finished_at, count(r.id) FILTER (WHERE r.status = 'pending') AS \"pending!\", count(r.id) FILTER (WHERE r.status = 'sent') AS \"sent!\", count(r.id) FILTER (WHERE r.status = 'failed') AS \"failed!\", count(r.id) FILTER (WHERE r.status = 'cancelled') AS \"cancelled!\" FROM bulk_sends AS b LEFT JOIN bulk_send_rows AS r ON r.account_id = b.account_id AND r.bulk_send_id = b.id WHERE b.account_id = $1 AND ($2::uuid IS NULL OR b.sender_user_id = $2) AND ($3::uuid IS NULL OR b.id = $3) GROUP BY b.id ORDER BY b.created_at DESC, b.id DESC LIMIT $4",
